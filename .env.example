# Copie este arquivo para .env (ou configure nas Environment Variables da Vercel)

# URL pública do site (sem barra no final)
# Local: http://localhost:3000  |  Produção: https://viceplay.cloud
BASE_URL=http://localhost:3000

# Segredo forte para assinar cookies de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Credenciais do /admin
ADMIN_USER=5288
ADMIN_PASS=5288

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI: {BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true = exibe botão "Simular pagamento (modo teste)" | false = produção real (só admin/webhook confirma)
DEMO_MODE=true
