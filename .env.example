# Copie este arquivo para .env (ou configure nas Environment Variables da Vercel)

# URL pública do site (sem barra no final)
# Local: http://localhost:3000  |  Produção: https://playgta6.com
BASE_URL=http://localhost:3000

# Segredo forte para assinar cookies de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# IDs do Discord autorizados a acessar o /admin (separados por vírgula)
ADMIN_DISCORD_IDS=seu_discord_id_1,seu_discord_id_2

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI: {BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true = exibe botão "Simular pagamento (modo teste)" | false = produção real (só admin/webhook confirma)
DEMO_MODE=true

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
# NUNCA commite suas chaves reais no Git! Coloque no .env local ou nas Environment Variables da Vercel.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Assinatura secreta de Webhooks do Mercado Pago (recomendado em produção)
MP_WEBHOOK_SECRET=

# NOWPayments Crypto (https://account.nowpayments.io/store-settings)
# IPN Webhook URL: {BASE_URL}/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Estado compartilhado na Vercel (Upstash Redis / Vercel KV REST API — evita perda de fila/status entre instâncias)
KV_REST_API_URL=
KV_REST_API_TOKEN=
